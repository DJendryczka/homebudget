rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(homeId) {
      return signedIn()
        && exists(/databases/$(database)/documents/homes/$(homeId)/members/$(request.auth.uid));
    }

    function isOwner(homeId) {
      return signedIn()
        && get(/databases/$(database)/documents/homes/$(homeId)).data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /expenses/{expenseId} {
        allow read: if signedIn() && request.auth.uid == uid;
      }
    }

    match /homes/{homeId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read, update: if isMember(homeId);

      match /members/{memberId} {
        allow read: if isMember(homeId);
        allow create: if signedIn() && (memberId == request.auth.uid || isOwner(homeId));
      }

      match /expenses/{expenseId} {
        allow read, create, update, delete: if isMember(homeId);
      }
    }
  }
}
